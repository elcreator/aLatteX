{
  "name": "elcreator/alattex",
  "license": "GPL-3.0-or-later",
  "description": "A Latte eXtended template parser for Evolution CMS",
  "type": "evolutioncms-plugin",
  "keywords": [
    "evo",
    "evocms",
    "evolution",
    "evolution-cms",
    "latte",
    "template"
  ],
  "require": {
    "php": "^8.3",
    "evolution-cms/evolution": "^3.5.2",
    "latte/latte": "^3.1"
  },
  "require-dev": {
    "pestphp/pest": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Elcreator\\aLatteX\\": "src/"
    }
  },
  "scripts": {
    "test": "pest --no-coverage",
    "demo:install": "@php bin/alattex-demo.php install",
    "demo:remove": "@php bin/alattex-demo.php remove"
  },
  "scripts-descriptions": {
    "test": "Run the unit and integration suite.",
    "demo:install": "Install the demo pages, templates, chunks, snippets and TVs into the surrounding Evolution CMS site.",
    "demo:remove": "Delete everything demo:install created."
  },
  "extra": {
    "laravel": {
      "providers": [
        "Elcreator\\aLatteX\\aLattexServiceProvider"
      ]
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
